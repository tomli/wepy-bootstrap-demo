<view class="mv-area w-100  d-flex justify-content-center" wx:if="{{posters[selectedPosterIdx]}}"
      style="left:0;bottom:5%;font-size: 21rpx" >
    <!--
    <image class="mv-handle" style="left:0px; top:50px; rotate: 270deg;" src="https://cdn-icons-png.flaticon.com/128/10255/10255559.png" />
    <image class="mv-handle" style="left:0px; top:-10px; rotate: 90deg;" src="https://cdn-icons-png.flaticon.com/128/10255/10255559.png" />
    <image class="mv-handle" style="left:30px; top:20px; rotate: 180deg;" src="https://cdn-icons-png.flaticon.com/128/10255/10255559.png" />
    <image class="mv-handle" style="left:-30px; top:20px; " src="https://cdn-icons-png.flaticon.com/128/10255/10255559.png" />
-->
    <view class="position-absolute" wx:if="{{optMode === 'move'}}">
        <image bindtap="down" class="mv-handle" style="left:0px; top:55px; rotate: 180deg; opacity:.5;" src="https://cdn-icons-png.flaticon.com/128/9589/9589490.png" />
        <image bindtap="up" class="mv-handle" style="left:0px; top:-15px; opacity:.5;" src="https://cdn-icons-png.flaticon.com/128/9589/9589490.png" />
        <image bindtap="right" class="mv-handle" style="left:35px; top:20px; rotate: 90deg; opacity:.5;" src="https://cdn-icons-png.flaticon.com/128/9589/9589490.png" />
        <image bindtap="left" class="mv-handle" style="left:-35px; top:20px;rotate: 270deg; opacity:.5;" src="https://cdn-icons-png.flaticon.com/128/9589/9589490.png" />

    </view>
    <view class="position-absolute" wx:if="{{optMode === 'rotate'}}">
        <image bindtap="flipLeft" class="mv-handle" style="left:35px; top:20px; rotate: 180deg; opacity:.9;" src="https://cdn-icons-png.flaticon.com/128/16904/16904582.png" />
        <image bindtap="flipRight" class="mv-handle" style="left:-35px; top:20px;rotate: 0deg; opacity:.9;" src="https://cdn-icons-png.flaticon.com/128/16904/16904582.png" />

    </view>
    <view class="position-absolute" wx:if="{{optMode === 'scale'}}">
        <image bindtap="small" class="mv-handle" style="left:45px; top:20px; rotate: 180deg; opacity:.9;" src="https://cdn-icons-png.flaticon.com/128/13348/13348466.png" />
        <image bindtap="large" class="mv-handle" style="left:-45px; top:20px;rotate: 0deg; opacity:.9;" src="https://cdn-icons-png.flaticon.com/128/13348/13348466.png" />

    </view>
    <image bindtap="changeOptMode" class="mv-handle" style="left:50%; top:20px;" src="https://6d6f-movief-b3iye-1300901012.tcb.qcloud.la/icons/ar/handle.png" />
<!--    <text class="mv-handle " style="left:52%; top:27px; opacity:.5;font-size: 18rpx">移动海\n报位置</text>-->
    <view class=" text-white" style="left:0px; top:85px; opacity:.5; margin-top: 90px">操作中海报：No.{{selectedPosterIdx+1}}《{{posters[selectedPosterIdx].film}}》</view>


    <!--
        <image class="mv-handle" style="left:0px; top:50px; rotate: 90deg;" src="https://cdn-icons-png.flaticon.com/128/7131/7131386.png" />
        <image class="mv-handle" style="left:0px; top:-10px; rotate: 270deg;" src="https://cdn-icons-png.flaticon.com/128/7131/7131386.png" />
        <image class="mv-handle" style="left:30px; top:20px; " src="https://cdn-icons-png.flaticon.com/128/7131/7131386.png" />
        <image class="mv-handle" style="left:-30px; top:20px;rotate: 180deg; " src="https://cdn-icons-png.flaticon.com/128/7131/7131386.png" />
        -->
<!--    <image class="mv-handle" style="left:{{hLeft}}px; top:{{hTop}}px;" src="https://6d6f-movief-b3iye-1300901012.tcb.qcloud.la/icons/ar/handle.png" />-->
</view>

<mp-halfScreenDialog title="切换操作中海报"
                     subTitle="点击海报图片切换"
                     show="{{displaySetting}}"
                     bindclose="toggleDisplaySetting" >
    <view class="page-section mt-n5 d-flex justify-content-around" slot="footer" >

        <view   class=" mx-auto"  style="width:570rpx;" >
            <view  style="width:190rpx; height:270rpx;" class="float-left"  wx:for="{{posters}}" wx:for-index="idx" >
                <image bindtap="selectPoster" data-idx="{{idx}}" class="{{'image-small '+(idx===selectedPosterIdx? 'active':'')}}"  src="{{item.image}}" wx:if="{{item}}" ></image>
            </view>
        </view>
<!--        <image class="float-left mr-2 image"  src="https://image.tmdb.org/t/p/w220_and_h330_face/dLWCaKcdspaFPZoZCKDVogioAep.jpg" ></image>-->
<!--        <image class="float-left image active"  src="https://6d6f-movief-b3iye-1300901012.tcb.qcloud.la/posters/test.png" ></image>-->
    </view>
</mp-halfScreenDialog>
<mp-halfScreenDialog title="选择要上墙的海报"
                     subTitle="点击海报图片切换"
                     show="{{displayMovieSearch}}"
                     bindclose="toggleDisplayMovieSearch">
    <view class="page-section mt-n5" slot="footer" >
        <scroll-view scroll-y  style="height: 750rpx" class="pb-3">
            <view   class=" mx-auto"  style="width:570rpx;" >
                <view  style="width:190rpx; height:270rpx;" class="float-left"  wx:for="{{fakePosters}}" wx:for-index="idx" >
                    <image bindtap="selectFakePoster" data-idx="{{idx}}" class="{{'image-small '+(idx===selectedPosterIdx? 'active':'')}}"  src="{{item.image}}" wx:if="{{item}}" ></image>
                </view>
            </view>
            <!--            https://wechat-miniprogram.github.io/weui/docs/search.html#%E5%B1%9E%E6%80%A7%E5%88%97%E8%A1%A8-->
            <mp-searchbar placeholder="输入影片名查找" bindselectresult="selectResult" search="{{search}}" ext-class="searchBar pre-wrap"></mp-searchbar>
        </scroll-view>
        <view class="px-4" wx:if="{{selectedSearchResult}}" >
            <button class="w-100 py-2 d-flex justify-content-center text-black-50 text-12" catchtap="selectPosterFromSearchResult">
                <text class="icon ion-md-add-circle-outline my-auto mr-1 text-12" > </text>
                <view class="my-auto">使用这张海报</view>
                <view class="bg-light rounded p-2">
                    <image class="image  mb-n2" data-openid="{{selectedUser.openid}}"
                           src="{{selectedUser.avatarUrl||selectedUser.wxUserInfo.avatarUrl}}"></image>
                </view>
                <view class="my-auto"></view>
            </button>
        </view>
    </view>
</mp-halfScreenDialog>
