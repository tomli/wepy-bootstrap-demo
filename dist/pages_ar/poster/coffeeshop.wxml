<view  class="{{'demo-wrap '+(platform === 'devtools'?'bg-dark':'')}}">
<!--<view  class="{{'demo-wrap '+(platform === 'devtools'?'':'')}}">-->
    <scroll-view class="demo-viewer" scroll-y="{{true}}" >
        <block bind:sceneReady="handleSceneReady">
            <wall
                    disable-scroll
                    id="main-frame"
                    touchMode="{{touchMode}}"
                    width="{{renderWidth}}"
                    height="{{renderHeight}}"
                    captureState="{{captureState}}"
                    selectedPosterIdx="{{selectedPosterIdx}}"
                    filmOnTheFly="{{filmOnTheFly}}"
                    posters="{{posters}}"
                    transferData="{{transferData}}"
                    bind:arTrackerState="handleMyARTrackerState"
                    bind:posterPlaced="handlePosterPlaced"
                    bindinfoListener="handleInfoListener"
                    style="width:{{width}}px;height:{{height}}px;top:{{top}}px;left:{{left}}px;display:block;"
            />
        </block>
        <view class="position-absolute" style="top:5px; left:5px"></view>
    </scroll-view>
    <view wx:if="{{false}}" class="xr-control w-100" style="bottom: 0rpx; right:1rpx">
        <view class="position-relative  img-wrap" style="top: 15rpx; right:10rpx" bind:tap="toggleDisplaySetting">
            <mp-icon icon="close" extClass="mt-1" type="field" color="white"  size="{{32}}"></mp-icon>
            <!--                <image class="hint-img" src="https://mmbizwxaminiprogram-1258344707.cos.ap-guangzhou.myqcloud.com/xr-frame/demo/wxball.jpg" />-->
        </view>
        <view class="intro">
            <view class="intro-detail d-flex justify-content-around">
                <button class="share" bindtap="flipX">X轴反转</button>
                <button class="share" bindtap="flipY">Y轴反转</button>
                <button class="share" bindtap="flipZ">Z轴反转</button>
                <button class="share" bindtap="reset">reset</button>
                <button class="share" bindtap="resetPlane">resetPlane</button>
            </view>
            <view class="intro-detail d-flex justify-content-around">
                <view class="my-auto " bindtap="up">⬆</view>
                <view class="my-auto " bindtap="down">⬇</view>
                <view class="my-auto " bindtap="left">⬅</view>
                <view class="my-auto " bindtap="right">➡︎</view>
                <view>
                    <button class=" btn btn-primary" bindtap="changeCaptureState">拍照</button>
                </view>
                <view>
                    <button class=" btn btn-primary" bindtap="changeLight">灯光</button>
                </view>
            </view>
            <view class="intro-detail">
                <view class="intro-title  d-none" ><text>{{title}}</text> <button class="share" open-type="share">分享给好友</button></view>
                <view class="description">showARTrackerState={{intro}}｜trackerUpdateTimes ={{trackerUpdateTimes}}</view>
            </view>
        </view>
        <view wx:if="{{hint.length > 0}}" class="d-none">
            <view class="hint-wrap">
                <text class="hint-words" >{{hint}}</text>
            </view>
        </view>
        <view class="holder d-none"></view>
    </view>
    <view class="back-btn-wrap" wx:if="{{showBackBtn}}" bind:tap="onClickBack">
        <view class="back-line-t"></view>
        <view class="back-line-b"></view>
    </view>


    <text class="position-absolute w-100 text-white text-center" wx:if="{{!displayMovieSearch && filmOnTheFly}}"  style="top: 50%;">{{hint}}</text>
<!--    <text class="position-absolute text-white pl-2 info-text"  wx:if="{{posters[selectedPosterIdx]}}"   style="bottom: 5rpx">操作中海报：No.{{selectedPosterIdx+1}}《{{posters[selectedPosterIdx].film}}》</text>-->

    <view class="xr-info" style="z-index: 1999">
        <view class="text-center"  wx:if="{{filmOnTheFly}}" bindtap="toggleDisplayMovieSearch">

                <image class=" image-small mx-3 border border-white" src="{{filmOnTheFly.image}}"   ></image>
            <!--        src="https://img9.doubanio.com/view/photo/l_ratio_poster/public/p2900433324.jpg"           -->
            <view class="text-white info-text" >
                《{{filmOnTheFly.film}}》
<!--                《伊拉克已逝之美伊拉克已逝之美》-->
                <view  class="text-muted" wx:if="{{displayMovieSearch}}" >点击使用这张海报</view></view>
<!--            <text class="text-white" style="font-size: 16rpx" wx:else >{{hint}}</text>-->
        </view>
        <block wx:else>

            <view class="info-text title">监听列表</view>
            <!--        <view class="info-text">小球速度:</view>-->
            <!--        <view class="info-text">X: {{speedX}}  Z: {{speedZ}}</view>-->
            <view class="info-text">海报位置:</view>
            <view class="info-text">X: {{posX}} Y: {{posY}}  Z: {{posZ}}</view>
            <view class="info-text">TrackerState: {{arTrackerState}}</view>
        </block>
    </view>

    <!-- Marker控制 -->
    <view class="xr-control" style="bottom: 20rpx; right:2rpx; z-index: 999">
        <view class="control-item active" bindtap="addPoster" wx:if="{{addedCount<6}}">
            <view class="img-wrap my-auto">
                <!--                <mp-icon icon="add" extClass="mt-1" type="field" color="white"  size="{{32}}"></mp-icon>-->
                <!--                <image class="hint-img" src="https://cdn-icons-png.flaticon.com/512/10272/10272767.png" />-->
                <!--                <image class="hint-img" src="https://cdn-icons-png.flaticon.com/512/17135/17135016.png" />-->
                <image class="hint-img" src="https://cdn-icons-png.flaticon.com/128/15742/15742831.png" />
                <!--                <image class="hint-img" src="https://cdn-icons-png.flaticon.com/128/15162/15162480.png" />-->
            </view>
        </view>
        <view class="control-item mt-1" bindtap="toggleDisplaySetting"  wx:if="{{addedCount>1}}">
            <!--            <view class="item-title">扫描显示识别框</view>-->
            <view class="img-wrap my-auto">
                <!--                <mp-icon icon="album" extClass="mt-1" type="field" color="white"  size="{{32}}"></mp-icon>-->
                <!--                                <image class="hint-img" src="https://cdn-icons-png.flaticon.com/128/14018/14018163.png" />-->
<!--                <image class="hint-img" src="https://cdn-icons-png.flaticon.com/128/10696/10696511.png" />-->
<!--                <image class="hint-img" src="https://cdn-icons-png.flaticon.com/128/1040/1040256.png" />-->
<!--                <image class="hint-img" src="https://cdn-icons-png.flaticon.com/128/3168/3168278.png" />-->
<!--                <image class="hint-img" src="https://cdn-icons-png.flaticon.com/128/5575/5575720.png" />-->
<!--                <image class="hint-img" src="https://cdn-icons-png.flaticon.com/128/10991/10991031.png" />-->
<!--                <image class="hint-img" src="https://cdn-icons-png.flaticon.com/128/10942/10942037.png" />-->
                <image class="hint-img" src="https://cdn-icons-png.flaticon.com/128/16011/16011460.png" />
<!--                <image class="hint-img" src="https://cdn-icons-png.flaticon.com/128/9646/9646550.png" />-->
            </view>
        </view>
        <view class="control-item mt-1" bindtap="changeCaptureState">
            <view class="img-wrap my-auto">
                <!--   图片来自     https://www.flaticon.com/free-icons/color-->
<!--                <image class="hint-img" src="https://6d6f-movief-b3iye-1300901012.tcb.qcloud.la/icons/photo.jpeg" />-->
<!--                <image class="mt-1" style="width: 70%;height: 70%;" src="https://cdn-icons-png.flaticon.com/128/15742/15742853.png" />-->

<!--                <image class="hint-img"   src="https://cdn-icons-png.flaticon.com/128/3687/3687416.png" />-->
<!--                <image class="hint-img"   src="https://cdn-icons-png.flaticon.com/128/5708/5708327.png" />-->
                <image class="hint-img"   src="https://cdn-icons-png.flaticon.com/128/17362/17362350.png" />
<!--                <image class="hint-img"   src="https://cdn-icons-png.flaticon.com/128/17478/17478651.png" />-->
            </view>
        </view>
    </view>
</view>


