.demo-wrap {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
}
.demo-viewer {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
}

.holder {
    height: 60rpx;
}

.hint-wrap {
    text-align: center;
}

.hint-words {
    display: block;
    font-size: 14px;
    color: #000;
    text-align: center;
    font-weight: normal;
    margin: 10px 20px;
    padding: 10px;
    border-radius: 5px;
    border: 1px dashed #000;
    background-color: #fff;
}

.intro {
    display: block;
    /*margin: 20rpx 0;*/
    background: #fff;
}

.intro .title {
    font-size: 36rpx;
    padding-bottom: 20rpx;
}

.intro .description {
    color: #8f8f8f;
    font-size: 28rpx;
}

.intro-detail {
    padding: 30rpx;
}


.code-inner {
    margin: 0rpx;
    padding: 30rpx;
    font-size: 30rpx;
    background-color: #f9f9fa;
}

.code-inner rich-text {
    word-wrap: break-word;
}

.block-name {
    display: inline-block;
    color: #b457ff;
}

.attr-name {
    display: inline-block;
    color: #ff4d00;
}

.ml20 {
    margin-left: 20rpx;
}

.intro-title {
    font-size: 30rpx;
    font-weight: bold;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 24rpx;
}

.share {
    margin: 0 !important;
    margin-left: 0 !important;
    margin-right: 0 !important;
    padding: 0;
    width: 120rpx !important;
    background: none;
    font-size: 28rpx;
    color: #ff4d00;
}

.back-btn-wrap {
    position: absolute;
    left: 30rpx;
    top: 100rpx;
    width: 290rpx;
    height: 80rpx;
}
.back-line-t {
    position: absolute;
    left: 20rpx;
    top: 15rpx;
    width: 30rpx;
    height: 6rpx;
    background-color: #fff;
    transform: rotate(-45deg);
    border-radius: 5rpx;
}
.back-line-b {
    position: absolute;
    left: 20rpx;
    top: 32rpx;
    width: 30rpx;
    height: 6rpx;
    background-color: #fff;
    transform: rotate(45deg);
    border-radius: 5rpx;
}
.xr-info {
    position: absolute;
    right: 0;
    top: 0;
    min-width: 200rpx;
    /*height: 160rpx;*/
    padding: 20rpx;
    background-color: #000;
    border-radius: 5px 0 0 5px;
}
.info-text {
    font-size: 20rpx;
    line-height: 30rpx;
    padding: 0;
    color: #fff;
}
.info-text.title {
    font-size: 24rpx;
    line-height: 40rpx;
    font-weight: bold;
}

.xr-control {
    position: absolute;
    /*left: 50%;*/
    width: 170rpx;
    /*height: 200rpx;*/
    /*margin-left: -360rpx;*/
    margin-top: -120rpx;
    text-align: center;
}

.control-item {
    display: inline-block;
    vertical-align: middle;
    width: 160rpx;
    margin: 0 10rpx;
    height: 100%;
    border-radius: 10rpx;
    text-align: center;
}

.control-item.active .item-title {
    color: #fff;
    background-color: forestgreen;
    border: 4rpx solid #fff;
}


.item-title {
    font-size: 18rpx;
    line-height: 60rpx;
    border-radius: 10rpx;
    border: 4rpx solid #000;
    background-color: #fff;
    transition: all 0.3s;
}

.img-wrap {
    display: inline-block;
    width: 80rpx;
    height: 80rpx;
    border-radius: 50rpx;
    margin: 10rpx 5rpx;
    overflow: hidden;
    border: 4rpx solid #fff;
}

.hint-img {
    width: 100%;
    height: 100%;
}

.hint-img.lh {
    height: 110%;
    padding-top: -5%;
}

.hint-img.lw {
    width: 130%;
    margin-left: -15%;
}

.image {
    /* margin-top: 30rpx; */
    width:210rpx;
    height:280rpx;
}
.image-small {
    width:165rpx;
    height:240rpx;
}

.rt-area{
    left:0;
    top:0;
    width: 100%;
    position:absolute;
}

.rt-bg{
    width: 100px;
    height: 100px;
    position: absolute;
}

.mv-area{
    left:30px;
    position:absolute;
}

.mv-bg{
    width: 100px;
    height: 100px;
}

.mv-handle{
    width: 40px;
    height: 40px;
    position: absolute;
}


.image-small.active  {
    background-color: forestgreen;
    border: 6rpx solid #1CD155;
}

.ext-class{
    border: 0px;
    font-size: 18rpx;
}

.weui-search-bar {
    /*background-color: #fff;*/
    border: 1px;
}
